generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum ReleaseEventType {
  SHELF
  PRERELEASE
  PROMO
  SPECIAL
}

enum DateType {
  EXACT
  RANGE
  WINDOW
  TBD
}

enum WindowGranularity {
  MONTH
  QUARTER
  YEAR
}

enum Region {
  GLOBAL
  NA
  EU
  APAC
  JP
  OTHER
}

enum ReleaseStatus {
  RUMORED
  ANNOUNCED
  CONFIRMED
  RELEASED
  CANCELLED
}

enum SourceTier {
  OFFICIAL
  RETAILER
  COMMUNITY
  SPECULATIVE
}

enum SourceDisposition {
  SUPPORTS
  CONTRADICTS
  SUPERSEDED
}

enum ScanScopeType {
  ALL
  INSTALL
}

enum ScanStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ScanTrigger {
  SCHEDULED
  MANUAL
}

enum DigestFrequency {
  DAILY
  WEEKLY
}

// ---------------------------------------------------------------------------
// Ingest v2 enums (lib/ingest/*). The v2 pipeline is built alongside the v1
// crawler (lib/crawler/*) and does not replace it yet -- everything below is
// additive so both can coexist against the same database until v2 takes over.
// ---------------------------------------------------------------------------

/// Outcome of one provider's fetch within an ingest run. NOT_MODIFIED is a
/// success (the conditional GET's ETag matched, so there was nothing new to
/// parse), DEGRADED means the fetch succeeded but the payload was partial or
/// suspicious, FAILED means no usable payload at all -- only FAILED providers
/// are re-fetched by retryRun (lib/ingest/replay.ts).
enum ProviderStatus {
  OK
  NOT_MODIFIED
  DEGRADED
  FAILED
}

/// Why a release event was routed to human review by the gate
/// (lib/ingest/gate.ts). One per gate rule that can flag: G5 -> CONFLICT,
/// G6 -> LARGE_SHIFT, plus two reserved for later phases.
enum ReviewReason {
  CONFLICT
  LARGE_SHIFT
  NEW_UNCORROBORATED
  ANOMALY
}

/// What the gate decided to do with an event this run. PUBLISH writes the new
/// date; HOLD leaves the currently published value alone with no review item;
/// FLAG also holds but additionally opens a ReviewItem; STALE records that the
/// supporting claims were absent this run (and, past the absence threshold,
/// cancels the event -- never deletes it).
enum VerdictAction {
  PUBLISH
  HOLD
  FLAG
  STALE
}

// ---------------------------------------------------------------------------
// TCG profile / product / release domain
// ---------------------------------------------------------------------------

model TcgProfilePackage {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  version           String
  description       String?
  discoveryConfig   Json
  sourceConfigs     Json
  imageSourceConfig Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  installs TcgProfileInstall[]
}

model TcgProfileInstall {
  id               String   @id @default(cuid())
  packageId        String
  installedVersion String
  enabled          Boolean  @default(false)
  settings         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  package       TcgProfilePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productSets   ProductSet[]
  discoveryHits DiscoveryHit[]
  scanRuns      ScanRun[]
  subscriptions Subscription[]

  @@index([packageId])
}

model ProductSet {
  id                  String    @id @default(cuid())
  tcgProfileInstallId String
  code                String?
  name                String?
  releaseQuarter      String?
  meta                Json?
  imageUrl            String?
  description         String?
  archivedAt          DateTime?
  mergedIntoId        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  install       TcgProfileInstall @relation(fields: [tcgProfileInstallId], references: [id], onDelete: Cascade)
  releaseEvents ReleaseEvent[]
  identities    SetIdentity[]

  // TODO(phase5): `code` is nullable but participates in the composite unique
  // below, and SQLite treats NULLs as distinct -- so any number of code-less
  // ProductSets can coexist in one install and the v1 crawler's
  // findOrCreateProductSet upsert can never match them. Fixing that means
  // either backfilling a synthetic code for every existing NULL row or moving
  // to a partial unique index, both of which would disrupt the v1 crawler
  // while it is still the live pipeline. Deferred to phase 5, once v2 owns
  // ProductSet writes and the backfill can run in the same migration.
  @@unique([tcgProfileInstallId, code])
  @@index([archivedAt])
}

model ReleaseEvent {
  id                    String             @id @default(cuid())
  productSetId          String
  type                  ReleaseEventType
  dateType              DateType
  dateExact             DateTime?
  dateStart             DateTime?
  dateEnd               DateTime?
  windowGranularity     WindowGranularity?
  windowStart           DateTime?
  windowEnd             DateTime?
  region                Region             @default(GLOBAL)
  status                ReleaseStatus      @default(RUMORED)
  confidence            Float              @default(0)
  sourceSummary         String?
  lastSeenAt            DateTime?
  isManualOverride      Boolean            @default(false)
  manualNotes           String?
  archivedAt            DateTime?
  mergedIntoId          String?
  movedFromProductSetId String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  productSet         ProductSet          @relation(fields: [productSetId], references: [id], onDelete: Cascade)
  sourceClaims       SourceClaim[]
  userNotes          UserNote[]
  eventFollows       EventFollow[]
  eventPersonalNotes EventPersonalNote[]
  eventDismissals    EventDismissal[]
  eventReactions     EventReaction[]
  reviewItems        ReviewItem[]

  @@index([productSetId, type])
  @@index([dateType, dateExact, dateStart])
  @@index([archivedAt])
  @@index([movedFromProductSetId])
}

model SourceClaim {
  id                      String            @id @default(cuid())
  releaseEventId          String
  tier                    SourceTier
  disposition             SourceDisposition
  confidenceWeight        Float
  url                     String
  host                    String?
  dateExact               DateTime?
  dateStart               DateTime?
  dateEnd                 DateTime?
  lastVerifiedAt          DateTime?
  raw                     Json?
  movedFromReleaseEventId String?
  // Both nullable so the v1 crawler's writes (which set neither) still
  // validate; the v2 ingest pipeline always sets both. `origin` is the
  // declared upstream identity from lib/ingest/types.ts's ORIGINS registry --
  // it's what the gate's independence test (G2) reasons about, and it is
  // deliberately NOT the same thing as `host` (two hosts can republish one
  // origin's data, which is exactly the correlation G2 must not be fooled by).
  origin                  String?
  // The ingest run that produced this claim. Together with `origin` and
  // `releaseEventId` this is the idempotency key that makes replay
  // convergent: re-running a stored run supersedes its own prior claims in
  // place instead of stacking a fresh duplicate every time (see
  // data/ingest/ingestRepo.ts's upsertIngestClaim). The event id stands in
  // for the spec's (productSetId, type) pair -- an event *is* a
  // (productSetId, type) within an install, so keying on it is equivalent
  // and doesn't denormalize productSetId onto every claim row.
  scanRunId               String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  releaseEvent ReleaseEvent @relation(fields: [releaseEventId], references: [id], onDelete: Cascade)

  // SQLite treats NULLs as distinct in a unique index, so every v1 crawler
  // claim (scanRunId + origin both NULL) is exempt from this constraint and
  // keeps its existing append-only behaviour.
  @@unique([scanRunId, origin, releaseEventId])
  @@index([releaseEventId, lastVerifiedAt])
  @@index([movedFromReleaseEventId])
}

model ScanRun {
  id         String        @id @default(cuid())
  scopeType  ScanScopeType
  scopeId    String?
  status     ScanStatus    @default(RUNNING)
  totals     Json?
  trigger    ScanTrigger
  // Set when this run was created by lib/ingest/replay.ts's retryRun as a
  // re-fetch of another run's FAILED providers. Kept as a plain string rather
  // than a self-relation: it's provenance for the run history UI, and a
  // self-relation would make the retention pass's deletes order-dependent.
  retryOfRunId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  install TcgProfileInstall? @relation(fields: [scopeId], references: [id], onDelete: SetNull)

  @@index([scopeId])
  @@index([retryOfRunId])
}

model DiscoveryHit {
  id                  String   @id @default(cuid())
  tcgProfileInstallId String
  url                 String
  title               String?
  raw                 Json?
  seenAt              DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  install TcgProfileInstall @relation(fields: [tcgProfileInstallId], references: [id], onDelete: Cascade)

  @@unique([tcgProfileInstallId, url])
}

model JobLock {
  id         String    @id @default(cuid())
  jobName    String
  scopeKey   String
  ownerId    String?
  acquiredAt DateTime  @default(now())
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([jobName, scopeKey])
}

// ---------------------------------------------------------------------------
// Ingest v2 substrate (lib/ingest/*)
//
// The design goal of everything below is that an ingest run is *replayable*:
// the network response is stored verbatim before anything interprets it, so
// every stage after Fetch is a pure function of stored bytes. That is what
// lets a parser bug be fixed and re-run against yesterday's data without
// re-hammering (or being lied to again by) an upstream site.
// ---------------------------------------------------------------------------

/// Maps an upstream provider's own identifier for a set onto our ProductSet.
/// This is the identity resolver's primary key path (lib/ingest/identity.ts):
/// an ID match is exact and stable, whereas the name-similarity fallback is a
/// guess, so anything we can pin by id should be pinned by id forever after.
model SetIdentity {
  id           String   @id @default(cuid())
  productSetId String
  /// Which upstream declares this id -- a key from ORIGINS in lib/ingest/types.ts.
  origin       String
  /// The upstream's own identifier, verbatim (e.g. Scryfall's set code, a TCGplayer group id).
  externalId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productSet ProductSet @relation(fields: [productSetId], references: [id], onDelete: Cascade)

  // Global rather than per-install: an origin's id space is the origin's, and
  // one external id must never resolve to two different ProductSets or the
  // resolver stops being deterministic.
  @@unique([origin, externalId])
  @@index([productSetId])
}

/// The replay substrate: one stored response body per (run, provider), written
/// by Fetch *before* any parsing happens, so a payload that crashes the parser
/// is still on disk to debug and re-run against.
model RawPayload {
  id          String   @id @default(cuid())
  scanRunId   String
  providerKey String
  /// SHA-256 of the uncompressed body, so an unchanged payload is detectable
  /// even from a provider that sends no ETag.
  contentHash String
  /// gzipped JSON (node:zlib). Bodies are large and highly compressible, and
  /// this table is the one that grows without bound.
  body        Bytes
  fetchedAt   DateTime

  @@unique([scanRunId, providerKey])
  // Retention scans this by age (30-day cleanup), never by run.
  @@index([fetchedAt])
}

/// Per-provider outcome within one run. Written alongside RawPayload before
/// parsing, so a provider that fails mid-parse is still recorded as having
/// been attempted -- and so retryRun can find exactly the FAILED ones.
model ProviderRun {
  id          String         @id @default(cuid())
  scanRunId   String
  providerKey String
  status      ProviderStatus
  /// Response ETag as returned this run, mirrored into ProviderEtag for the next run's conditional GET.
  etag        String?
  /// How many Candidates the parse yielded; 0 with status OK is itself a signal worth alerting on.
  candidates  Int            @default(0)
  error       String?
  startedAt   DateTime
  finishedAt  DateTime?

  @@unique([scanRunId, providerKey])
  @@index([providerKey, startedAt])
}

/// What one run actually changed, as a machine-readable diff. Separate from
/// ScanRun.totals (which is only counts) because a human reviewing a bad run
/// needs to see *which* events moved, not how many.
model RunDiff {
  id        String   @id @default(cuid())
  scanRunId String   @unique
  changes   Json
  createdAt DateTime @default(now())
}

/// A gate decision that needs a human. Created by FLAG verdicts (G5/G6); the
/// event keeps its previously published value until this is resolved, so an
/// open ReviewItem is a hold, not just a notification.
model ReviewItem {
  id             String       @id @default(cuid())
  releaseEventId String
  reason         ReviewReason
  /// The competing claims, machine-readable -- enough to reconstruct the
  /// decision without re-reading the run's payloads.
  detail         Json
  /// Human-readable prose. Null until a Reviewer is wired up in a later phase;
  /// nothing should depend on it being present.
  summary        String?
  resolvedAt     DateTime?
  resolvedNote   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  releaseEvent ReleaseEvent @relation(fields: [releaseEventId], references: [id], onDelete: Cascade)

  // The review queue is "everything still open", so resolvedAt leads.
  @@index([resolvedAt])
  @@index([releaseEventId])
}

/// Last-seen ETag per provider, so a conditional GET survives across runs.
/// Deliberately not folded into ProviderRun: that table is per-run history and
/// gets pruned, whereas this is a single current-state row per provider that
/// must outlive any individual run's retention.
model ProviderEtag {
  id            String   @id @default(cuid())
  providerKey   String
  etag          String?
  lastFetchedAt DateTime
  /// Hash of the last body actually stored, for providers that send no ETag.
  contentHash   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([providerKey])
}

// ---------------------------------------------------------------------------
// Identity / auth (NextAuth Prisma adapter shape) + personalization
// ---------------------------------------------------------------------------

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  name                 String?
  image                String?
  emailVerified        DateTime?
  role                 UserRole        @default(USER)
  active               Boolean         @default(true)
  timezone             String?
  emailAlertsEnabled   Boolean         @default(false)
  discordWebhookUrl    String?
  discordAlertsEnabled Boolean         @default(false)
  isPremium            Boolean         @default(false)
  // Set whenever an admin manually toggles isPremium (data/admin/adminRepo.ts's
  // setUserPremium). While true, the Stripe webhook (syncSubscriptionFromStripe/
  // clearSubscription) reports subscription status/dates as usual but leaves
  // isPremium alone, so an admin override can't be silently clobbered by a
  // routine renewal or cancellation event. Cleared automatically the next time
  // this user completes a real Stripe checkout, since that's an explicit signal
  // real billing should take back over.
  premiumOverride      Boolean         @default(false)
  stripeCustomerId     String?         @unique
  stripeSubscriptionId String?         @unique
  stripeSubscriptionStatus String?
  premiumCurrentPeriodEnd DateTime?
  dashboardCardIds     Json?
  digestEmailEnabled   Boolean         @default(false)
  digestFrequency      DigestFrequency @default(DAILY)
  leadTimeReminderDays Int?
  icalToken            String?         @unique
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  accounts           Account[]
  sessions           Session[]
  userNotes          UserNote[]
  subscriptions      Subscription[]
  eventFollows       EventFollow[]
  eventPersonalNotes EventPersonalNote[]
  eventDismissals    EventDismissal[]
  eventReactions     EventReaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                  String   @id @default(cuid())
  userId              String
  tcgProfileInstallId String
  createdAt           DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  install TcgProfileInstall @relation(fields: [tcgProfileInstallId], references: [id], onDelete: Cascade)

  @@unique([userId, tcgProfileInstallId])
}

model UserNote {
  id                      String   @id @default(cuid())
  userId                  String
  releaseEventId          String
  content                 String
  movedFromReleaseEventId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseEvent ReleaseEvent @relation(fields: [releaseEventId], references: [id], onDelete: Cascade)

  @@index([userId, releaseEventId])
  @@index([movedFromReleaseEventId])
}

// Premium event-level personalization (item 24): follow/dismiss/note are
// each unique per (user, event), unlike UserNote's public comment thread
// above. movedFromReleaseEventId carries the same merge-reassignment
// pattern as SourceClaim/UserNote (see crawlerRepo.mergeReleaseEvents) so
// a dedup merge doesn't silently orphan a user's follow/note/dismissal
// onto an archived, invisible duplicate event.

model EventFollow {
  id                      String   @id @default(cuid())
  userId                  String
  releaseEventId          String
  movedFromReleaseEventId String?
  createdAt               DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseEvent ReleaseEvent @relation(fields: [releaseEventId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseEventId])
  @@index([movedFromReleaseEventId])
}

model EventPersonalNote {
  id                      String   @id @default(cuid())
  userId                  String
  releaseEventId          String
  content                 String
  movedFromReleaseEventId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseEvent ReleaseEvent @relation(fields: [releaseEventId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseEventId])
  @@index([movedFromReleaseEventId])
}

model EventDismissal {
  id                      String   @id @default(cuid())
  userId                  String
  releaseEventId          String
  movedFromReleaseEventId String?
  createdAt               DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseEvent ReleaseEvent @relation(fields: [releaseEventId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseEventId])
  @@index([movedFromReleaseEventId])
}

// Free-tier emoji reactions (item 32): one reaction per (user, event), like
// EventFollow/EventDismissal above -- not premium-gated, requireUser() only.
// A user's reaction is just an emoji string from a fixed set (see
// eventDisplay.ts's REACTION_EMOJIS); changing their pick updates the row
// rather than adding a second one.
model EventReaction {
  id                      String   @id @default(cuid())
  userId                  String
  releaseEventId          String
  emoji                   String
  movedFromReleaseEventId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseEvent ReleaseEvent @relation(fields: [releaseEventId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseEventId])
  @@index([releaseEventId, emoji])
  @@index([movedFromReleaseEventId])
}
