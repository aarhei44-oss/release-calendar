generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum ReleaseEventType {
  SHELF
  PRERELEASE
  PROMO
  SPECIAL
}

enum DateType {
  EXACT
  RANGE
  WINDOW
  TBD
}

enum WindowGranularity {
  MONTH
  QUARTER
  YEAR
}

enum Region {
  GLOBAL
  NA
  EU
  APAC
  JP
  OTHER
}

enum ReleaseStatus {
  RUMORED
  ANNOUNCED
  CONFIRMED
  RELEASED
  CANCELLED
}

enum SourceTier {
  OFFICIAL
  RETAILER
  COMMUNITY
  SPECULATIVE
}

enum SourceDisposition {
  SUPPORTS
  CONTRADICTS
  SUPERSEDED
}

enum ScanScopeType {
  ALL
  INSTALL
}

enum ScanStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ScanTrigger {
  SCHEDULED
  MANUAL
}

// ---------------------------------------------------------------------------
// TCG profile / product / release domain
// ---------------------------------------------------------------------------

model TcgProfilePackage {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  version         String
  description     String?
  discoveryConfig Json
  sourceConfigs   Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  installs TcgProfileInstall[]
}

model TcgProfileInstall {
  id               String   @id @default(cuid())
  packageId        String
  installedVersion String
  enabled          Boolean  @default(false)
  settings         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  package       TcgProfilePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productSets   ProductSet[]
  discoveryHits DiscoveryHit[]
  scanRuns      ScanRun[]
  subscriptions Subscription[]

  @@index([packageId])
}

model ProductSet {
  id                  String    @id @default(cuid())
  tcgProfileInstallId String
  code                String?
  name                String?
  releaseQuarter      String?
  meta                Json?
  archivedAt          DateTime?
  mergedIntoId        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  install       TcgProfileInstall @relation(fields: [tcgProfileInstallId], references: [id], onDelete: Cascade)
  releaseEvents ReleaseEvent[]

  @@unique([tcgProfileInstallId, code])
  @@index([archivedAt])
}

model ReleaseEvent {
  id                     String             @id @default(cuid())
  productSetId           String
  type                   ReleaseEventType
  dateType               DateType
  dateExact              DateTime?
  dateStart              DateTime?
  dateEnd                DateTime?
  windowGranularity      WindowGranularity?
  windowStart            DateTime?
  windowEnd              DateTime?
  region                 Region             @default(GLOBAL)
  status                 ReleaseStatus      @default(RUMORED)
  confidence             Float              @default(0)
  sourceSummary          String?
  lastSeenAt             DateTime?
  isManualOverride       Boolean            @default(false)
  manualNotes            String?
  archivedAt             DateTime?
  mergedIntoId           String?
  movedFromProductSetId  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  productSet   ProductSet    @relation(fields: [productSetId], references: [id], onDelete: Cascade)
  sourceClaims SourceClaim[]
  userNotes    UserNote[]

  @@index([productSetId, type])
  @@index([dateType, dateExact, dateStart])
  @@index([archivedAt])
  @@index([movedFromProductSetId])
}

model SourceClaim {
  id                      String            @id @default(cuid())
  releaseEventId          String
  tier                    SourceTier
  disposition             SourceDisposition
  confidenceWeight        Float
  url                     String
  host                    String?
  dateExact               DateTime?
  dateStart               DateTime?
  dateEnd                 DateTime?
  lastVerifiedAt          DateTime?
  raw                     Json?
  movedFromReleaseEventId String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  releaseEvent ReleaseEvent @relation(fields: [releaseEventId], references: [id], onDelete: Cascade)

  @@index([releaseEventId, lastVerifiedAt])
  @@index([movedFromReleaseEventId])
}

model ScanRun {
  id         String        @id @default(cuid())
  scopeType  ScanScopeType
  scopeId    String?
  status     ScanStatus    @default(RUNNING)
  totals     Json?
  trigger    ScanTrigger
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  install TcgProfileInstall? @relation(fields: [scopeId], references: [id], onDelete: SetNull)

  @@index([scopeId])
}

model DiscoveryHit {
  id                  String   @id @default(cuid())
  tcgProfileInstallId String
  url                 String
  title               String?
  raw                 Json?
  seenAt              DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  install TcgProfileInstall @relation(fields: [tcgProfileInstallId], references: [id], onDelete: Cascade)

  @@unique([tcgProfileInstallId, url])
}

model JobLock {
  id         String    @id @default(cuid())
  jobName    String
  scopeKey   String
  ownerId    String?
  acquiredAt DateTime  @default(now())
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([jobName, scopeKey])
}

// ---------------------------------------------------------------------------
// Identity / auth (NextAuth Prisma adapter shape) + personalization
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          UserRole  @default(USER)
  active        Boolean   @default(true)
  timezone      String?
  emailAlertsEnabled Boolean @default(false)
  discordWebhookUrl    String?
  discordAlertsEnabled Boolean @default(false)
  isPremium     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  userNotes     UserNote[]
  subscriptions Subscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                  String   @id @default(cuid())
  userId              String
  tcgProfileInstallId String
  createdAt           DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  install TcgProfileInstall @relation(fields: [tcgProfileInstallId], references: [id], onDelete: Cascade)

  @@unique([userId, tcgProfileInstallId])
}

model UserNote {
  id                      String   @id @default(cuid())
  userId                  String
  releaseEventId          String
  content                 String
  movedFromReleaseEventId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseEvent ReleaseEvent @relation(fields: [releaseEventId], references: [id], onDelete: Cascade)

  @@index([userId, releaseEventId])
  @@index([movedFromReleaseEventId])
}
