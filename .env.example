DATABASE_URL="file:./dev.db"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# comma-separated list of emails granted ADMIN role on first sign-in
ADMIN_EMAILS=""

# crawler scan interval in minutes (in-process scheduler)
CRAWLER_SCHEDULE="1440"

# site address used by Caddy in production (e.g. calendar.example.com)
SITE_ADDRESS="localhost"

SEED_ON_BOOT="true"

# outbound mail for "email me when a subscribed game changes" alerts.
# leave SMTP_HOST unset to disable email alerts entirely (they no-op with a
# log line instead of erroring, so this is optional).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Release Watcher <no-reply@releasewatcher.com>"

# Google AdSense (Auto Ads). Leave unset to show no ads at all -- this is
# your AdSense publisher ID (format "ca-pub-XXXXXXXXXXXXXXXX"), issued only
# after you've created an AdSense account and Google has approved this site
# for it. Get one at https://adsense.google.com. Once set, this both loads
# the Auto Ads script (app/layout.tsx) and populates /ads.txt (required by
# Google for fraud verification) -- no other setup needed on this end.
ADSENSE_CLIENT_ID=""
