DATABASE_URL="file:./dev.db"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# comma-separated list of emails granted ADMIN role on first sign-in
ADMIN_EMAILS=""

# crawler scan interval in minutes (in-process scheduler)
CRAWLER_SCHEDULE="1440"

# site address used by Caddy in production (e.g. calendar.example.com)
SITE_ADDRESS="localhost"

SEED_ON_BOOT="true"
